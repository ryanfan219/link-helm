{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Link Helm",
  "version": "1.0.0",
  "identifier": "com.yzbb.linkhelm",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Link Helm Settings",
        "url": "index.html",
        "width": 1040,
        "height": 700,
        "minWidth": 860,
        "minHeight": 580,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Link Helm cross-browser identity router",
    "longDescription": "Route external links to the right browser identity.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    }
  }
}
